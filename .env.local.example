# ============================================================
# 比价书 BookPrice 环境变量示例
# 复制为 .env.local 并填入真实密钥；不配置的平台会显示「暂时不可用」，
# 绝不影响其他平台与整体功能（Key 只在服务端 Route Handler 读取，永不暴露给前端）
# ============================================================

# ---- 孔夫子旧书网 开放平台（https://open.kongfz.com）----
KONGFZ_KEY=
KONGFZ_SECRET=
# 可选：自定义接口地址（默认 https://openapi.kongfz.com/kfz_open/api/kfz.item.search）
KONGFZ_ENDPOINT=

# ---- onebound 聚合 API · 闲鱼（goodfish）渠道（https://open.onebound.cn）----
ONEBOUND_KEY=
ONEBOUND_SECRET=
# 可选：自定义接口地址（默认 https://api.onebound.cn/onebound/goodfish/item_search）
ONEBOUND_ENDPOINT=

# ---- 京东联盟 开放平台（https://union.jd.com）----
JD_APP_KEY=
JD_APP_SECRET=

# ---- 有路网 轻量页面抓取 ----
# 可选：自定义搜索页地址（默认 https://www.youlu.net/search，已内置 1 秒限频）
YOULU_SEARCH_URL=

# ---- Google Books API ----
# 可选：不填也可调用（匿名共享配额），配置后可获得更高配额
GOOGLE_BOOKS_API_KEY=
